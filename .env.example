# ---- General ----
LOG_LEVEL=INFO
DATA_DIR=/data
PUBLIC_BASE_URL=http://localhost:8000
# Protect the demo: if set, every /api/v1 call needs "Authorization: Bearer <token>"
API_TOKEN=
RATE_LIMIT_PER_MINUTE=60
ALLOW_PRIVATE_URLS=false
CALLBACK_SECRET=change-me
MAX_WORKERS=2

# ---- Storage (local disk or S3-compatible such as MinIO) ----
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=broll
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---- Providers: every external service sits behind an adapter chosen here ----
# Speech-to-text: mock (no key; reads a transcript hint, does not listen) | faster_whisper (real)
STT_PROVIDER=mock
WHISPER_MODEL=base
# Text-to-speech: espeak (no key; robotic, GPL-3.0 run as a separate process) | mock
TTS_PROVIDER=espeak
# Scene planner: heuristic (no key) | openai_compat (any OpenAI-compatible chat endpoint)
PLANNER_PROVIDER=heuristic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Footage, in priority order: pexels,pixabay,mock
FOOTAGE_PROVIDERS=mock
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Limits and rules ----
MAX_AUDIO_SECONDS=600
MAX_DOWNLOAD_MB=200
HTTP_TIMEOUT=20
MIN_SCENE_SECONDS=2.0
MAX_SCENE_SECONDS=8.0
MIN_RELEVANCE=1.8
PORTRAIT_MODE=blur_fit

# ---- Cost model (estimates written to manifest.json; not billing data) ----
COST_PER_LLM_CALL_USD=0
COST_PER_TTS_CHAR_USD=0
COMPUTE_COST_PER_HOUR_USD=0.10
